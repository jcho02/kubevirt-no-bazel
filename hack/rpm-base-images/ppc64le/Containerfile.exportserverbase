# ppc64le base image of virt-exportserver. The RPMs are installed with dnf,
# because there is no bazeldnf for ppc64le.

FROM quay.io/centos/centos:stream10

RUN dnf -y --enablerepo=crb install --setopt=install_weak_deps=False \
        tar libnbd nbdkit nbdkit-basic-filters nbdkit-basic-plugins nbdkit-curl-plugin \
        nbdkit-server qemu-img && \
    dnf clean all

RUN groupadd -g 1001 nonroot-user && \
    useradd -u 1001 -g 1001 -d /home/nonroot-user -m -s /sbin/nologin nonroot-user
