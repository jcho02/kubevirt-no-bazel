# ppc64le libvirt and libnbd headers and libraries that hack/build-image-binaries.sh
# compiles virt-launcher and virt-handler against. Installed with dnf into a
# separate root, so that only the development files and their dependencies are
# copied. libvirt-devel comes from kvm-power, at the version of the launcher base.

FROM quay.io/centos/centos:stream10 AS devel

RUN printf '[kvm-power]\nname=kvm-power\nbaseurl=https://mirror.stream.centos.org/SIGs/10-stream/virt/ppc64le/kvm-power/\ngpgcheck=0\nenabled=1\n' > /etc/yum.repos.d/kvm-power.repo

RUN dnf -y --enablerepo=crb --installroot=/devel --releasever=10 install \
        --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
        libvirt-devel-12.5.0-1.virt.el10 libvirt-libs-12.5.0-1.virt.el10 libnbd-devel && \
    dnf clean all

FROM scratch

COPY --from=devel /devel/usr/lib64/pkgconfig /usr/lib64/pkgconfig
COPY --from=devel /devel/usr/include /usr/include
COPY --from=devel /devel/usr/lib64 /usr/lib64
